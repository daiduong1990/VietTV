<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext HTTP is permitted at OS transport level strictly so user-configured RFC1918 Local LAN Whisper
         endpoints (e.g. http://192.168.1.10:8000) work on Android 9-14; VoiceSttClient.validateEndpointUrl()
         and LivePrices enforce HTTPS-only for all public internet hosts in Java. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
